root = true

# 统一 UTF-8 + LF，与 .gitattributes 保持一致
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 的行尾双空格是换行语法，不能裁掉
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2
