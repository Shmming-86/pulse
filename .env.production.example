# ============================================
# Pulse 看板 生产环境配置模板
# 复制为 .env 后按需修改；.env 含敏感信息，不要提交版本库
# 所有项均可省略，省略时使用括号中的默认值
# ============================================

# 运行环境：production
NODE_ENV=production

# 监听地址：本机部署 127.0.0.1；容器/Docker 或需要局域网访问时 0.0.0.0
# (127.0.0.1)
HOST=127.0.0.1

# 监听端口 (4173)
PORT=4173

# 数据目录，存放 SQLite 数据库 kanban.db（建议用绝对路径）(./data)
# DATA_DIR=/opt/kanban-pulse/data

# SQLite 数据库文件名 (kanban.db)
# DB_FILE=kanban.db

# 旧版 JSON 数据文件名；首次启动时若存在且库为空，自动迁移到 SQLite (db.json)
# LEGACY_JSON_FILE=db.json

# 首次启动数据策略：empty=空库（仅一名管理员，生产推荐）；demo=32 条演示任务
# 仅在数据库为空时生效；已有数据不受影响
# (生产环境默认 empty，开发环境默认 demo)
SEED_MODE=empty

# 允许跨域访问的来源，多个用逗号分隔；生产环境禁止使用 *
# 填用户浏览器实际访问的地址（走反代后就是站点自身地址，通常保持默认即可）
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# 是否信任反向代理头（X-Forwarded-For）：部署在 Nginx 之后设为 true，
# 直接对公网暴露时必须保持 false，否则限流可被伪造头绕过
# (false)
TRUST_PROXY=false

# 每个 IP 每分钟的接口请求上限 (600)
RATE_LIMIT_MAX=600

# 请求体大小上限（字节），默认 256KB (262144)
BODY_LIMIT_BYTES=262144

# 单个请求处理超时（毫秒）(30000)
REQUEST_TIMEOUT_MS=30000

# 日志级别：debug | info | warn | error (info)
LOG_LEVEL=info
