{
  "name": "kanban-pulse",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "description": "小团队任务跟踪与分析看板（JIRA / Plane 风格）",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "node -e \"process.env.NODE_ENV='production';import('./server/index.js')\"",
    "dev": "node --watch server/index.js",
    "reset": "node scripts/reset.js",
    "clear": "node scripts/clear.js",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "package": "node scripts/build-package.mjs",
    "snapshot": "bash scripts/snapshot.sh",
    "worktree": "bash scripts/worktree.sh"
  },
  "license": "Apache-2.0"
}
